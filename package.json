{
  "name": "wohni-spiele",
  "version": "0.1.0",
  "private": true,
  "description": "Gemeinschaftsspiele für Handy-Browser – lokal oder auf eigenem Server",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node --experimental-strip-types --no-warnings server/index.ts",
    "test": "node --experimental-strip-types --no-warnings --test \"server/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  }
}
